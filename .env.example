# Copy to .env and adjust. Used by docker-compose and cloud deployments.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8080
CORS_ALLOW_ALL=true
TIME_ZONE=Asia/Kolkata

POSTGRES_DB=foodbridge
POSTGRES_USER=foodbridge
POSTGRES_PASSWORD=foodbridge
POSTGRES_PORT=5432

# Shared secret between Django and the FastAPI ML service (internal endpoints)
SERVICE_API_KEY=change-me-service-key
REQUIRE_SERVICE_KEY=true
BATCH_EVERY_HOURS=6
ENABLE_SCHEDULER=true
EXPIRY_SCAN_INTERVAL_MIN=60

# Seed demo organizations/users on first start
SEED_DEMO=true

# Email notifications (console backend prints them to logs)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com  EMAIL_PORT=587  EMAIL_HOST_USER=...  EMAIL_HOST_PASSWORD=...  EMAIL_USE_TLS=true

# Public URLs baked into the Flutter web build
PUBLIC_API_URL=http://localhost:8000/api
PUBLIC_ML_DOCS_URL=http://localhost:8001/docs

# Performance / protection
# REDIS_URL=redis://localhost:6379/0     # shared dashboard cache (compose sets this)
DASHBOARD_CACHE_SECONDS=30
THROTTLE_ANON=120/min
THROTTLE_USER=1200/min
THROTTLE_LOGIN=20/min
THROTTLE_POS=600/min
